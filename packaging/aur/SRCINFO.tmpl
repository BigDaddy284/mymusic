pkgbase = mymusic-bin
	pkgdesc = Spotify and YouTube Music in one customizable player
	pkgver = {{.PkgVer}}
	pkgrel = 1
	url = https://github.com/bigdaddy284/mymusic
	arch = x86_64
	arch = aarch64
	license = MIT OR GPL-3.0-only
	depends = gtk3
	depends = webkit2gtk-4.1
	depends = alsa-lib
	depends = hicolor-icon-theme
	optdepends = libpulse: sound through PulseAudio or PipeWire
	optdepends = libayatana-appindicator: the tray icon
	optdepends = libsecret: keep sign-ins in the keyring
	optdepends = yt-dlp: the few YouTube Music tracks that need it, which MyMusic can also install itself
	optdepends = deno: the JavaScript runtime yt-dlp solves YouTube with
	optdepends = nodejs: another JavaScript runtime yt-dlp can use
	provides = mymusic
	conflicts = mymusic
	options = !strip
	options = !debug
	source = LICENSE-MIT::https://raw.githubusercontent.com/bigdaddy284/mymusic/v{{.Version}}/LICENSE-MIT
	sha256sums = {{.LicenseSHA256}}
	source_x86_64 = mymusic-{{.Version}}-linux-amd64.deb::https://github.com/bigdaddy284/mymusic/releases/download/v{{.Version}}/mymusic-{{.Version}}-linux-amd64.deb
	sha256sums_x86_64 = {{.AMD64SHA256}}
	source_aarch64 = mymusic-{{.Version}}-linux-arm64.deb::https://github.com/bigdaddy284/mymusic/releases/download/v{{.Version}}/mymusic-{{.Version}}-linux-arm64.deb
	sha256sums_aarch64 = {{.ARM64SHA256}}

pkgname = mymusic-bin
